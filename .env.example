# Copy this file to .env and fill in your own values.
# NEVER commit your real .env file to git.

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_key_here

# Current vision-capable model (verified Sept 2026 from https://console.groq.com/docs/vision).
# Options: qwen/qwen3.8-27b (recommended, best quality), qwen/qwen3.6-27b (alternative).
GROQ_MODEL=qwen/qwen3.8-27b

# OpenAI-compatible endpoint for Groq. Do not change unless Groq announces a new URL.
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Max uploaded image size in MB (server-side validation). Groq allows up to 20MB for
# image URLs; base64 requests should stay small, so we compress server-side.
MAX_IMAGE_MB=10

# Port the app runs on
PORT=8000
